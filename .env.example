# --- Postgres ---
POSTGRES_DB=bykoji
POSTGRES_USER=bykoji
POSTGRES_PASSWORD=troque-esta-senha

# --- Segurança ---
# chave para rotas /admin e /test
ADMIN_KEY=troque-admin-key
# chave que as Skills do Skyone usam para chamar /api/*
SKILLS_API_KEY=troque-skills-key
# segredo na URL do webhook do uazapi: /webhooks/uazapi?s=<valor>
UAZAPI_WEBHOOK_SECRET=troque-webhook-secret

# --- Debounce ---
DEBOUNCE_S=4
MAX_WAIT_S=12
HISTORY_TURNS=20
PAUSE_MINUTES=60

# --- Agente Skyone ---
# mock = resposta simulada (mede só a VPS); live = chama o fluxo do Skyone
SKYONE_MODE=mock
SKYONE_WEBHOOK_URL=
SKYONE_TOKEN=troque-token-skyone
SKYONE_TIMEOUT_S=60
SLOW_NOTICE_S=15
MOCK_MIN_S=2
MOCK_MAX_S=5

# --- uazapi ---
# dry = não envia nada ao WhatsApp (só grava); live = envia de verdade
SEND_MODE=dry
UAZAPI_BASE_URL=https://SEU-SUBDOMINIO.uazapi.com
UAZAPI_TOKEN=
